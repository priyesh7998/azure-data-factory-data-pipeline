					"server": "[parameters('ds_azure_sql_src_properties_typeProperties_server')]",
					"database": "[parameters('ds_azure_sql_src_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('ds_azure_sql_src_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('ds_azure_sql_src_password')]"
					}
				}
			},
			"dependsOn": []
		},
