{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-project-adf"
		},
		"ds_azure_sql_src_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ds_azure_sql_src'"
		},
		"ds_datalake_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ds_datalake'"
		},
		"ds_local_files_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ds_local_files'"
		},
		"ds_azure_sql_src_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "adf-project-srvr.database.windows.net"
		},
		"ds_azure_sql_src_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "adf-project-db"
		},
		"ds_azure_sql_src_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "adfprojectadmin"
		},
		"ds_datalake_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adfprojectstoragee.dfs.core.windows.net/"
		},
		"ds_github_src_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://raw.githubusercontent.com"
		},
		"ds_local_files_properties_typeProperties_host": {
			"type": "string",
			"defaultValue": "D:\\#DATA_ENGINEER\\__PROJECTS\\ADF_PROJECT"
		},
		"ds_local_files_properties_typeProperties_userId": {
			"type": "string",
			"defaultValue": "priye"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-project-adf_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ds_azure_sql_src_password": {
						"value": "[parameters('ds_azure_sql_src_password')]"
					},
					"ds_datalake_accountKey": {
						"value": "[parameters('ds_datalake_accountKey')]"
					},
					"ds_local_files_password": {
						"value": "[parameters('ds_local_files_password')]"
					},
					"ds_azure_sql_src_properties_typeProperties_server": {
						"value": "[parameters('ds_azure_sql_src_properties_typeProperties_server')]"
					},
					"ds_azure_sql_src_properties_typeProperties_database": {
						"value": "[parameters('ds_azure_sql_src_properties_typeProperties_database')]"
					},
					"ds_azure_sql_src_properties_typeProperties_userName": {
						"value": "[parameters('ds_azure_sql_src_properties_typeProperties_userName')]"
					},
					"ds_datalake_properties_typeProperties_url": {
						"value": "[parameters('ds_datalake_properties_typeProperties_url')]"
					},
					"ds_github_src_properties_typeProperties_url": {
						"value": "[parameters('ds_github_src_properties_typeProperties_url')]"
					},
					"ds_local_files_properties_typeProperties_host": {
						"value": "[parameters('ds_local_files_properties_typeProperties_host')]"
					},
					"ds_local_files_properties_typeProperties_userId": {
						"value": "[parameters('ds_local_files_properties_typeProperties_userId')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}