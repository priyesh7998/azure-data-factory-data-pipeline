						"name": "ExecuteSql-pipe",
						"type": "ExecutePipeline",
						"dependsOn": [
							{
								"activity": "ExecuteAPI-pipe",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"secureInput": false
